rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is Regional Engineer
    function isRegionalEngineer() {
      return isAuthenticated() && getUserData().role == 'Regional Engineer';
    }
    
    // Helper function to check if user has admin privileges
    function isAdminRole() {
      return isAuthenticated() && getUserData().role == 'Regional Engineer';
    }
    
    // Helper function to check if user is blocked
    function isBlocked() {
      return isAuthenticated() && getUserData().blocked == true;
    }
    
    // Users collection rules
    match /users/{userId} {
      // Regional Engineers can read all users
      allow read: if isAuthenticated() && isAdminRole();
      
      // Regional Engineers can create/update/delete users
      allow create, update, delete: if isAuthenticated() && isAdminRole();
      
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow authenticated users to create and update their own profile (for first-time login)
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Connections collection rules (renamed from applications)
    match /connections/{connectionId} {
      // All authenticated users can read connections
      allow read: if isAuthenticated();
      
      // Allow create only if authenticated and not blocked
      allow create: if isAuthenticated() && !isBlocked();
      
      // Allow update only if authenticated and not blocked
      allow update: if isAuthenticated() && !isBlocked();
      
      // Allow delete for admin users only
      allow delete: if isAuthenticated() && isAdminRole();
    }
    
    // Legacy applications collection (for migration period)
    match /applications/{applicationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && !isBlocked();
      allow delete: if isAuthenticated() && isAdminRole();
    }
    
    // Categories collection rules
    match /categories/{categoryId} {
      // All users can read categories
      allow read: if true;
      
      // Only Regional Engineers can create/update/delete categories
      allow create, update, delete: if isAuthenticated() && isAdminRole();
    }
    
    // GPS History collection rules
    match /gpsHistory/{historyId} {
      // Authenticated users can read GPS history
      allow read: if isAuthenticated();
      
      // Authenticated users can create GPS history entries (append-only)
      allow create: if isAuthenticated() && !isBlocked();
      
      // Only admins can delete history
      allow delete: if isAuthenticated() && isAdminRole();
      
      // Prevent updates (history is immutable)
      allow update: if false;
    }

    // System logs collection rules
    match /systemLogs/{logId} {
      // Only Regional Engineer can read/delete logs
      allow read, delete: if isAuthenticated() && isAdminRole();

      // Authenticated non-blocked users can write logs
      allow create: if isAuthenticated() && !isBlocked();

      // Logs are immutable
      allow update: if false;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
